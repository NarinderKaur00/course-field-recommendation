# ===========================================================================
#  EduPath portal — environment template
#  Copy this file to ".env" (same folder) and fill in YOUR OWN values.
#  The .env file is git-ignored, so your real secrets never get committed.
#      cp .env.example .env     (PowerShell:  Copy-Item .env.example .env)
# ===========================================================================

# ---- Database (your own MongoDB Atlas cluster — gives YOU full data access) --
# Leave BOTH unset to use the in-memory demo DB (resets on restart).
# Get this string from MongoDB Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=edupath

# ---- App security (make these YOUR OWN) ------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password

# ---- AI assistant + specialization advisor (optional) ----------------------
# none  -> built-in rule-based answers (no key, always works)
# groq  -> FREE, no credit card: get a key at https://console.groq.com (gsk_...)
# anthropic / openai -> paid (sk-ant-... / sk-...)
LLM_PROVIDER=none
# LLM_API_KEY=gsk_your_free_groq_key
# LLM_MODEL=                      # optional; sensible default per provider

# ---- Cookies (set to 1 only when served over HTTPS in production) ----------
COOKIE_SECURE=0
